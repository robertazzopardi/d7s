# d7s README demo — isolated fake connections only.
# Prereq: just demo

Output demo.gif

Require docker
Require sqlite3

Set Shell "bash"
Set Width 1200
Set Height 800
Set Theme "Aardvark Blue"
Set FontSize 14
Set Padding 20
Set TypingSpeed 50ms
Set Framerate 30

Hide
Type "PS1='$ '"
Enter
Type "clear"
Enter
Type "./demo/run.sh"
Enter
Sleep 2.5s
Show

Sleep 1.2s
Down@400ms 1
Sleep 800ms
Enter
Sleep 2s

Enter
Sleep 2s
Down@400ms 2
Sleep 1s
Escape
Sleep 800ms

Type "e"
Sleep 2s
Down@400ms 1
Sleep 1.2s
Escape
Sleep 800ms

Escape
Sleep 600ms
Escape
Sleep 1s

Enter
Sleep 800ms
Type@40ms "d7s_password"
Enter
Sleep 2.5s

Enter
Sleep 2s
Down@400ms 2
Enter
Sleep 2s
Down@400ms 2
Enter
Sleep 2s
Down@400ms 2
Sleep 1s
Escape
Sleep 800ms

Type "e"
Sleep 2s
Down@400ms 1
Sleep 1.2s
Escape
Sleep 800ms

Escape
Sleep 600ms
Escape
Sleep 600ms
Escape
Sleep 600ms
Escape
Sleep 1s

Sleep 800ms
Type "q"
Sleep 1s
